# ── 定品大模型：DeepSeek 官方直连（OpenAI 兼容端点） ──────────────────
# 需要支持 /chat/completions、response_format={"type":"json_object"}，
# 以及服务端联网工具 deepseek_web_search。
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# ⚠️ 填 API 文档里的**模型 ID**，不是控制台显示名。
#    DeepSeek-V4.1-Flash 对应的 ID 是 deepseek-flash；填显示名会被 400 拒绝。
DEEPSEEK_MODEL=deepseek-flash

# 单次模型调用上限（毫秒）。联网那一轮包含搜索 + 读页，比纯生成慢；40s 是实测够用的值。
LLM_TIMEOUT_MS=40000

# 原生联网：声明 deepseek_web_search，由官方执行检索（不额外按次计费）。
# 🔴 声明服务端工具后**不能**再带 response_format（会 400），所以 JSON 定稿仍是单独一轮。
# 置 0 = 退回 Tavily 代模型检索（旧的 function calling 闭环，需要 TAVILY_API_KEY）。
LLM_WEB_SEARCH=1

# 兼容旧部署：Vercel 上的密钥仍叫 LLM_FALLBACK_API_KEY，代码按
# DEEPSEEK_API_KEY → LLM_FALLBACK_API_KEY → LLM_API_KEY 依次取第一个非空值。
# 中转站时代的 LLM_BASE_URL / LLM_MODEL / LLM_FALLBACK_BASE_URL /
# LLM_FALLBACK_MODEL / LLM_FALLBACK_TIMEOUT_MS 已不再读取，可以删除。

# ── 商品图视觉质检：把候选图真的发给多模态模型看一眼 ──────────────
# 开着（默认）时，每张候选图会发一次带图的请求，判定：
#   是不是干净的商品展示图 / 有没有水印站标促销文案 / 画的是不是这款型号。
# 关掉（置 0）则退回老规则：只认品牌官方域名上的图，第三方图整片不要。
# ⚠️ 用的模型必须真的能看图。当前官方线上的 deepseek-flash ✅（模型列表 input_modalities 含 image）。
#    换模型时按系列逐型号实测，别按系列推断 —— 探测脚本见 scripts/probe-vision.mjs。
IMAGE_JUDGE=1
# 质检单独指模型（留空 = 复用 LLM_MODEL）。
IMAGE_JUDGE_MODEL=
# 单张图的判定上限（毫秒）。实测成功判定集中在 2.4~9.3s。
# ⚠️ 口径是「一张图**总共**最多花多久」：下载 + base64 路径 + 远程 URL 兜底路径都算在内。
#    它**不是**单次请求超时 —— 当成单次超时写过，最坏变成 2×20s，实测出现单张 40.9s。
# 🔴 也别设太大：同一批候选并行判定，批次墙钟 = 最慢那张，而**失败**的那张一定会顶满上限。
#    实测设 25000 时日志连续出现 `judgeMs:25005` + "This operation was aborted"，
#    单个用例的质检累计烧到 58.9s。12s 足够覆盖成功样本，又把最坏批次砍掉一半多。
IMAGE_JUDGE_TIMEOUT_MS=12000

# ── 找图用搜索源：Tavily（可选）──────────────────────────────────
# 文字检索已交给 deepseek_web_search；原生工具不返回图片列表，所以「官方域定向找商品图」
# 和「第三方候选图」仍由 Tavily 提供。留空 = 少这两级，最终更常退回品牌标。
TAVILY_API_KEY=

# ── 二级兜底：Cloudflare Worker 商品库（D1 + Vectorize）───────────
# 🔴 这是「后路」，别删。大模型不可用时，这里接手定品，保证站点还能出卡片。
#    大模型线路只剩 DeepSeek 一条，它挂了就是「没有模型可用」；
#    Worker 是**换一整套数据源**（D1 真实库存 + 向量召回），完全不依赖大模型。
#    两者互不替代 —— 模型挂了用后者，模型正常时它连碰都不会碰。
# 部署：wrangler deploy（配置见 worker/wrangler.jsonc，D1/Vectorize 绑定都写在里面）
# 部署后把线上地址填到这里；留空则视为「没有兜底」，大模型失败时直接报错。
WORKER_CHAT_URL=https://retail-ai-agent-worker.abobb-retail-ai-agent.workers.dev/api/chat
# 可选：把 Worker 域名固定到这个 IP，绕开国内 DNS 解析问题（留空则正常解析）。
WORKER_RESOLVE_IP=
