# ── 首选定品引擎：买手大模型（OpenAI 兼容端点） ──────────────────
# 需要支持 /chat/completions 与 response_format={"type":"json_object"}
LLM_API_KEY=replace-with-your-llm-api-key
LLM_BASE_URL=https://e-flowcode.cc/v1
LLM_MODEL=glm-5.3-flash

# 单次模型调用上限（毫秒）。快模型 6000 足够；用 glm-5.3-flash 这类推理模型要 40000+。
LLM_TIMEOUT_MS=40000

# ── 备用线路：主出口不可用时的第二条腿（DeepSeek 官方直连）──────────
# 留空 = 没有备用线路，主线路失败就直接交给 Worker 兜底。
#
# 该不该配？判据是**换出口，而不是换型号**：
#   ❌ 同一个中转站里换个模型 —— 抖动是链路级的，换型号救不回来，只让用户多等一个完整超时
#   ✅ 换一家、换一条网络路径 —— 故障域不重叠，才是真的冗余
# 中转站通常走跨境，官方直连在国内；跨境长连接被中间设备掐断是实测存在的
# （30~58s 之间断开，伴随 ERR_SSL_DECRYPTION_FAILED_OR_BAD_RECORD_MAC），
# 而同期国内站点空闲连接稳定。这类故障就是靠这条腿接住的。
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=https://api.deepseek.com/v1
# ⚠️ 注意填的是 API 文档里的**模型 ID**，不是控制台显示的名字。
#    DeepSeek 官方：显示名 "DeepSeek-V4.1-Flash" 对应的 ID 是 deepseek-flash。
#    填错会在第一次请求时被 400 顶回来（The supported API model names are ...）。
LLM_FALLBACK_MODEL=deepseek-flash
# 备用线路的单次上限（毫秒）。留空 = 复用 LLM_TIMEOUT_MS。
# 国内直连快且稳，通常可以比主线路收得更紧，让「备用也挂了」早点暴露。
LLM_FALLBACK_TIMEOUT_MS=30000

# ── 商品图视觉质检：把候选图真的发给多模态模型看一眼 ──────────────
# 开着（默认）时，每张候选图会发一次带图的请求，判定：
#   是不是干净的商品展示图 / 有没有水印站标促销文案 / 画的是不是这款型号。
# 关掉（置 0）则退回老规则：只认品牌官方域名上的图，第三方图整片不要。
# ⚠️ 用的模型必须真的能看图。实测：glm-5.3-flash ✅、deepseek-v4.1-flash ✅、glm-5.3 ❌（带图直接 400）。
#    同一个系列里逐型号实测，别按系列推断 —— 探测脚本见 scripts/probe-vision.mjs。
IMAGE_JUDGE=1
# 质检单独指模型（留空 = 复用 LLM_MODEL）。想看更准可以填 glm-5.3-flash，代价是慢。
IMAGE_JUDGE_MODEL=
# 单张图的判定上限（毫秒）。实测成功判定集中在 2.4~9.3s。
# ⚠️ 口径是「一张图**总共**最多花多久」：下载 + base64 路径 + 远程 URL 兜底路径都算在内。
#    它**不是**单次请求超时 —— 当成单次超时写过，最坏变成 2×20s，实测出现单张 40.9s。
# 🔴 也别设太大：同一批候选并行判定，批次墙钟 = 最慢那张，而**失败**的那张一定会顶满上限。
#    实测设 25000 时日志连续出现 `judgeMs:25005` + "This operation was aborted"，
#    单个用例的质检累计烧到 58.9s。12s 足够覆盖成功样本，又把最坏批次砍掉一半多。
IMAGE_JUDGE_TIMEOUT_MS=12000

# ── 二级兜底：Cloudflare Worker 商品库（D1 + Vectorize）───────────
# 🔴 这是「后路」，别删。大模型不可用时，这里接手定品，保证站点还能出卡片。
#    与 LLM_FALLBACK_* 的分工：LLM_FALLBACK_* 是**换出口**（模型能力不变，换一条网络路径），
#    Worker 是**换一整套数据源**（D1 真实库存 + 向量召回，完全不依赖大模型）。
#    两者互不替代 —— 出口挂了用前者，大模型整条链路挂了用后者。
# 部署：wrangler deploy（配置见仓库根目录 wrangler.jsonc，D1/Vectorize 绑定都写在里面）
# 部署后把线上地址填到这里；留空则视为「没有兜底」，大模型失败时直接报错。
WORKER_CHAT_URL=https://retail-ai-agent-worker.abobb-retail-ai-agent.workers.dev/api/chat
# 可选：把 Worker 域名固定到这个 IP，绕开国内 DNS 解析问题（留空则正常解析）。
WORKER_RESOLVE_IP=
